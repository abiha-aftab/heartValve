# Copy to .env and fill in. Never commit the real file.

# Build from the bundled fixtures instead of Kontent (no network, no keys).
# When set, the Kontent variables below are ignored.
KONTENT_OFFLINE=

# Kontent project (Project settings -> API keys).
GATSBY_KONTENT_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Language codenames, comma separated; the first one is the default.
GATSBY_KONTENT_LANGUAGE_CODENAMES=default,de
# Base URL the browser uses to list languages for the regional selector.
GATSBY_DELIVERY_API_URL=https://deliver.kontent.ai/
